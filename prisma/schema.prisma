generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  phoneNumber      String            @unique @map("phone_number")
  isVerified       Boolean           @default(false) @map("is_verified")
  otpCode          String?           @map("otp_code")
  otpExpiresAt     DateTime?         @map("otp_expires_at")
  role             Role              @default(USER)
  deletedAt        DateTime?         @map("deleted_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  business         Business?
  reviews          ProductReview[]
  favoriteProducts FavoriteProduct[]
  followedStores   StoreFollower[]
  reports          Report[]
  deviceTokens     DeviceToken[]
  adminAuditLogs   AdminAuditLog[]
  notifications    Notification[]

  // Chat relations
  conversationParticipants ConversationParticipant[]
  messagesSent             Message[]    @relation("MessagesSent")
  messageVisibility        MessageVisibility[]
  blocksGiven              UserBlock[]  @relation("BlocksGiven")
  blocksReceived           UserBlock[]  @relation("BlocksReceived")

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

model Business {
  id             String    @id @default(uuid())
  userId         String    @unique @map("user_id")
  businessName   String    @map("business_name")
  description    String?   @db.Text
  contactPhone   String    @map("contact_phone")
  cityId         String    @map("city_id")
  addressDetails String    @db.Text @map("address_details")
  logoUrl        String?   @map("logo_url") @db.Text
  isActive       Boolean   @default(true) @map("is_active")
  isFeatured     Boolean   @default(false) @map("is_featured")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  city           City      @relation(fields: [cityId], references: [id], onDelete: Restrict)
  products       Product[]
  advertisements Advertisement[]
  followers      StoreFollower[]

  @@index([cityId])
  @@index([isFeatured])
  @@map("businesses")
}

model StoreFollower {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  businessId String   @map("business_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@map("store_followers")
}

model Governorate {
  id        String   @id @default(uuid())
  nameAr    String   @map("name_ar")
  cities    City[]

  @@map("governorates")
}

model City {
  id             String      @id @default(uuid())
  governorateId  String      @map("governorate_id")
  nameAr         String      @map("name_ar")
  
  governorate    Governorate @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  businesses     Business[]

  @@map("cities")
}

model Category {
  id         String     @id @default(uuid())
  parentId   String?    @map("parent_id")
  nameAr     String     @map("name_ar")
  iconUrl    String?    @map("icon_url") @db.Text
  sortOrder  Int        @default(0) @map("sort_order")
  isActive   Boolean    @default(true) @map("is_active")

  parent     Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children   Category[] @relation("SubCategories")
  products   Product[]

  @@map("categories")
}

model Product {
  id              String         @id @default(uuid())
  businessId      String         @map("business_id")
  categoryId      String         @map("category_id")
  title           String
  description     String         @db.Text
  price           Decimal        @db.Decimal(10, 2)
  currency        String         @default("YER")
  unitOfSale      String         @map("unit_of_sale")
  status          ProductStatus  @default(PENDING)
  rejectionReason String?        @db.Text @map("rejection_reason")
  revisionReason  String?        @db.Text @map("revision_reason")
  isAvailable     Boolean        @default(true) @map("is_available")
  lastAvailabilityNotifiedAt DateTime? @map("last_availability_notified_at")
  isFeatured      Boolean        @default(false) @map("is_featured")
  averageRating   Decimal        @default(0.0) @db.Decimal(3, 2) @map("average_rating")
  reviewsCount    Int            @default(0) @map("reviews_count")
  deletedAt       DateTime?      @map("deleted_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  business        Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images          ProductImage[]
  reviews         ProductReview[]
  favoritedBy     FavoriteProduct[]

  @@index([businessId])
  @@index([status, categoryId])
  @@index([isFeatured])
  @@map("products")
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  NEEDS_REVISION
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  imageUrl   String   @map("image_url") @db.Text
  isCover    Boolean  @default(false) @map("is_cover")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductReview {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  userId     String   @map("user_id")
  rating     Int      @db.TinyInt
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@map("product_reviews")
}

model FavoriteProduct {
  userId     String   @map("user_id")
  productId  String   @map("product_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("favorite_products")
}

model Report {
  id          String       @id @default(uuid())
  reporterId  String?      @map("reporter_id")
  targetType  ReportTarget @map("target_type")
  targetId    String       @map("target_id")
  reason      String       @db.Text
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at")

  reporter    User?        @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  @@map("reports")
}

enum ReportTarget {
  PRODUCT
  REVIEW
  BUSINESS
  MESSAGE
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
}

model DeviceToken {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  fcmToken       String         @map("fcm_token")
  devicePlatform DevicePlatform @map("device_platform")
  lastUsedAt     DateTime       @default(now()) @map("last_used_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

enum DevicePlatform {
  ANDROID
  IOS
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String?  @map("admin_id")
  action    String
  targetId  String   @map("target_id")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  admin     User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@map("admin_audit_logs")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  title     String
  body      String           @db.Text
  type      NotificationType
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  PRODUCT_SUSPENDED
  PRODUCT_NEEDS_REVISION
  NEW_CHAT_MESSAGE
  NEW_REVIEW
  SYSTEM_ALERT
  NEW_PRODUCT_RELEASE
}

// ─── Chat System Models ─────────────────────────────────────────

model Conversation {
  id              String                    @id @default(uuid())
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  lastMessageId   String?                   @unique @map("last_message_id")

  participants    ConversationParticipant[]
  messages        Message[]
  lastMessage     Message?                  @relation("LastMessage", fields: [lastMessageId], references: [id], onDelete: SetNull)

  @@map("conversations")
}

model ConversationParticipant {
  id                String       @id @default(uuid())
  conversationId    String       @map("conversation_id")
  userId            String       @map("user_id")
  lastReadMessageId String?      @map("last_read_message_id")
  joinedAt          DateTime     @default(now()) @map("joined_at")
  isMuted           Boolean      @default(false) @map("is_muted")
  isArchived        Boolean      @default(false) @map("is_archived")
  isDeleted         Boolean      @default(false) @map("is_deleted")

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id              String       @id @default(uuid())
  conversationId  String       @map("conversation_id")
  senderId        String       @map("sender_id")
  type            MessageType  @default(TEXT)
  text            String?      @db.Text
  tempId          String?      @map("temp_id")
  replyToId       String?      @map("reply_to_id")
  deletedAt       DateTime?    @map("deleted_at")
  deletedForAll   Boolean      @default(false) @map("deleted_for_all")
  createdAt       DateTime     @default(now()) @map("created_at")

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User         @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo         Message?     @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         Message[]    @relation("Replies")
  reference       MessageReference?
  visibility      MessageVisibility[]
  lastOfConversation Conversation? @relation("LastMessage")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// Per-user message hiding. A sender can delete a message for everyone through
// Message.deletedForAll; deleting it only for themselves must not change what
// the other participant or conversation-intelligence pipeline can see.
model MessageVisibility {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  deletedAt DateTime @default(now()) @map("deleted_at")

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_visibility")
}

enum MessageType {
  TEXT
  PRODUCT_REFERENCE
  STORE_REFERENCE
  SYSTEM_MESSAGE
}

model MessageReference {
  id               String  @id @default(uuid())
  messageId        String  @unique @map("message_id")
  referenceType    String  @map("reference_type")
  referenceId      String  @map("reference_id")
  snapshotTitle    String? @map("snapshot_title")
  snapshotPrice    String? @map("snapshot_price")
  snapshotImage    String? @map("snapshot_image")    @db.Text
  snapshotMeta     Json?   @map("snapshot_meta")

  message          Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([referenceType, referenceId])
  @@map("message_references")
}

model UserBlock {
  id          String   @id @default(uuid())
  blockerId   String   @map("blocker_id")
  blockedId   String   @map("blocked_id")
  createdAt   DateTime @default(now()) @map("created_at")

  blocker     User     @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked     User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("user_blocks")
}

// ─── WhatsApp & System Models ───────────────────────────────────

model WhatsAppTemplate {
  id        String   @id @default(uuid())
  type      String   @unique // e.g., 'PRODUCT_INQUIRY', 'STORE_INQUIRY'
  content   String   @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("whatsapp_templates")
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model UnitOfSale {
  id        String   @id @default(uuid())
  nameAr    String   @unique @map("name_ar")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("units_of_sale")
}

model Advertisement {
  id        String    @id @default(uuid())
  imageUrl  String    @map("image_url") @db.Text
  storeId   String?   @map("store_id")
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  store     Business? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@map("advertisements")
}
