{
  "name": "home-business-backend",
  "version": "1.0.0",
  "description": "Backend for Yemen Home Business Marketplace",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:pm2": "pm2 start ecosystem.config.js --env production",
    "dev": "nodemon src/server.js",
    "generate:jwt": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "file-type": "^16.5.4",
    "firebase-admin": "^14.2.0",
    "helmet": "^7.0.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "prisma": "^5.0.0"
  }
}
