# Runtime
PORT=3000

# ------------------------------------------------------------------------------
# AI Integration Settings
# ------------------------------------------------------------------------------
# Set to 'true' to enable AI features (Marketplace Assistant, Chat Intelligence)
AI_ENABLED=true
# AI Provider (currently 'gemini' is supported)
AI_PROVIDER=gemini
# Models
AI_CHAT_MODEL=gemini-2.5-flash
AI_STRUCTURED_MODEL=gemini-2.5-flash
AI_EMBEDDING_MODEL=text-embedding-004
# Secret Key
GEMINI_API_KEY=your_gemini_api_key_here
# Execution Limits
AI_TIMEOUT_MS=15000
AI_MAX_TOOL_ROUNDS=4
NODE_ENV=development
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173

# Firebase and WhatsApp (configure only when those integrations are enabled)
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_STORAGE_BUCKET=
WHATSAPP_BUSINESS_PHONE=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# AI. Keep AI_ENABLED=false until the provider and rate limits are configured.
AI_ENABLED=false
AI_CONVERSATION_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_CHAT_MODEL=
AI_STRUCTURED_MODEL=
AI_EMBEDDING_MODEL=
AI_TIMEOUT_MS=20000
AI_MAX_TOOL_ROUNDS=4
AI_ASSISTANT_LIMIT_PER_15_MIN=20
AI_CONVERSATION_LIMIT_PER_15_MIN=10

# Stage 5 semantic search and background work. Leave blank until introduced.
REDIS_URL=
QDRANT_URL=
QDRANT_API_KEY=
